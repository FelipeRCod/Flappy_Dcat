{
  "expo": {
    "name": "Flappy Dcat",
    "slug": "flappy-dcat",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "sdkVersion": "57.0.0",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#000000"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset"
    ]
  }
}
